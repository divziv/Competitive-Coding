Problem Link:
https://leetcode.com/problems/minimum-operations-to-reduce-x-to-zero/?envType=daily-question&envId=2026-09-23

Solution:
class Solution {
public:
    int minOperations(vector<int>& nums, int x) {
        int n = nums.size();
        long long total = 0;

        for(int num : nums)
            total += num;

        long long t = total - x;

        if(t < 0)
            return -1;

        int l = 0;
        long long s = 0;
        int m = -1;

        for(int r = 0; r < n; r++) 
        {
            s += nums[r];

            while(l <= r && s > t) 
            {
                s -= nums[l++];
            }

            if(s == t) 
            {
                m = max(m, r - l + 1);
            }
        }

        if(m == -1)
            return -1;

        return n - m;
    }
};
