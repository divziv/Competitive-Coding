#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        int c = 0;

        for(int i = 1; i <= n; i++) 
        {
            int p;
            cin >> p;

            if(p == i) 
            {
                c++;
            }
        }

        cout << (c + 1) / 2 << "\n";
    }

    return 0;
}
