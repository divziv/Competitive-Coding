#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        vector<pair<long long, int>> a(n);
        for(int i = 0; i < n; ++i) 
        {
            cin >> a[i].first;
            a[i].second = i;
        }

        sort(a.begin(), a.end());

        vector<long long> p(n);
        p[0] = a[0].first;
        for(int i = 1; i < n; ++i)
            p[i] = p[i - 1] + a[i].first;

        vector<int> v(n);

        int r = 0;
        for(int i = 0; i < n; ++i) 
        {
            if(i == n - 1 || p[i] < a[i + 1].first)
                r = i;
        }

        for(int i = n - 1; i >= 0; --i) 
        {
            if(i == n - 1 || p[i] < a[i + 1].first)
                r = i;
            v[a[i].second] = r;
        }

        for(int i = 0; i < n; ++i)
            cout << v[i] << (i + 1 == n ? '\n' : ' ');
    }

    return 0;
}
