Problem Link:
https://leetcode.com/problems/maximum-alternating-sum-of-squares/?envType=daily-question&envId=2026-10-13

Solution:
class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        sort(nums.begin(), nums.end(), [](int a, int b) {
            return abs(a) < abs(b);
        });

        long long m = 0;
        int n = nums.size();

        for(int i = 0; i < n; i++) 
        {
            long long x = nums[i];

            if(i < n / 2) 
            {
                m -= x * x;
            } 
            else 
            {
                m += x * x;
            }
        }

        return m;
    }
};
