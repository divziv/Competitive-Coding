Solution:
class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();
        int d = 0;
        int l = 0, r = 0;

        for(int i = 0; i < n / 2; ++i) 
        {
            if(num[i] == '?')
                ++l;
            else
                d += num[i] - '0';
        }

        for(int i = n / 2; i < n; ++i) 
        {
            if(num[i] == '?')
                ++r;
            else
                d -= num[i] - '0';
        }

        return (l + r) % 2 == 1 || 2 * d != 9 * (r - l);
    }
};
