https://leetcode.com/problems/longest-strictly-increasing-or-strictly-decreasing-subarray/?envType=daily-question&envId=2026-11-12

Solution:
class Solution {
public:
    int longestMonotonicSubarray(vector<int>& nums) {
        int n = nums.size();
        if(n == 1) 
            return 1;
        
        int m = 1;
        int il = 1;
        int dl = 1;
        
        for(int i = 1; i < n; ++i) 
        {
            if(nums[i] > nums[i-1]) 
            {
                il++;
                dl = 1;
            } 
            else if(nums[i] < nums[i-1]) 
            {
                dl++;
                il = 1;
            } 
            else
            {
                il = 1;
                dl = 1;
            }
            
            m = max(m, max(il, dl));
        }
        
        return m;
    }
};
