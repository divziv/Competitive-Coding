#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        int x = INT_MAX, y = INT_MAX;
        int s = 0;

        for(int i = 0; i < n; ++i) 
        {
            int v;
            cin >> v;

            if(v <= x) 
            {
                x = v;
            } 
            else if(v <= y) 
            {
                y = v;
            } 
            else 
            {
                ++s;
                x = v;
            }

            if(x > y)
                swap(x, y);
        }

        cout << s << '\n';
    }

    return 0;
}
