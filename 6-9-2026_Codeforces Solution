#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    
    while(t--) {
        int n;
        cin >> n;

        if(n % 2 != 0) 
        {
            cout << "NO\n";
        } 
        else 
        {
            cout << "YES\n";
            for(int i = 0; i < n; i += 2) 
            {
                char c1 = 'A' + (i % 4);
                cout << c1 << c1;
            }
            cout << "\n";
        }
    }
    return 0;
}
