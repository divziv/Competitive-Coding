#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        map<int, int> m;

        for(int i = 0; i < n; ++i)
        {
            int x;
            cin >> x;
            m[x]++;
        }

        bool f = false;

        for(auto p : m)
        {
            if(p.second > 1)
            {
                f = true;
                break;
            }
        }

        if(f)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
