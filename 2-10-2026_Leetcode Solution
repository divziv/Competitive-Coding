https://leetcode.com/problems/generate-parentheses/?envType=daily-question&envId=2026-10-02

Solution:
class Solution {
public:
    vector<string> generateParenthesis(int n)
    {
        vector<string> v;
        string s;

        function<void(int, int)> backtrack = [&](int open, int close)
        {
            if(open == n && close == n)
            {
                v.push_back(s);
                return;
            }

            if(open < n)
            {
                s.push_back('(');
                backtrack(open + 1, close);
                s.pop_back();
            }

            if(close < open)
            {
                s.push_back(')');
                backtrack(open, close + 1);
                s.pop_back();
            }
        };

        backtrack(0, 0);
        return v;
    }
};
