#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        long long n, k;
        cin >> n >> k;

        k--;

        if(n % 2 == 1) 
        {
            k += k / (n / 2);
        }

        cout << (k % n) + 1 << '\n';
    }

    return 0;
}
