https://leetcode.com/problems/score-of-parentheses/?envType=daily-question&envId=2026-10-05

Solution:
class Solution {
public:
    int scoreOfParentheses(string s) {
        stack<int> st;
        st.push(0);

        for(char c : s) 
        {
            if(c == '(') 
            {
                st.push(0);
            } 
            else 
            {
                int inner = st.top();
                st.pop();
                int score = (inner == 0) ? 1 : 2 * inner;
                st.top() += score;
            }
        }

        return st.top();
    }
};
