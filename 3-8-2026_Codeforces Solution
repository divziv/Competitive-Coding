#include <bits/stdc++.h>
using namespace std;

int main() {

    int n;
    cin >> n;
    priority_queue<long long, vector<long long>, greater<long long>> pq;
    long long health = 0;

    for(int i = 0; i < n; i++) 
    {
        long long x;
        cin >> x;
        health += x;
        pq.push(x);
        if(health < 0) 
        {
            health -= pq.top();
            pq.pop();
        }
    }

    cout << pq.size();
    return 0;
}
