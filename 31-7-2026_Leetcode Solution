Problem Link:
https://leetcode.com/problems/minimum-number-of-pushes-to-type-word-ii/?envType=daily-question&envId=2026-07-31

Solution:
class Solution {
public:
    int minimumPushes(string word) {
        vector<int> freq(26, 0);

        for(char c : word)
            freq[c - 'a']++;

        sort(freq.begin(), freq.end(), greater<int>());

        int m = 0;
        for(int i = 0; i < 26; i++) 
        {
            if(freq[i] == 0) 
                break;
            m += freq[i] * (i / 8 + 1);
        }

        return m;
    }
};
