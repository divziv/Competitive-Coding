Solution:
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        long long a, b, x, y, n;
        cin >> a >> b >> x >> y >> n;

        long long a1 = a, b1 = b, n1 = n;
        long long d = min(a1 - x, n1);
        a1 -= d;
        n1 -= d;
        d = min(b1 - y, n1);
        b1 -= d;

        long long ans1 = a1 * b1;

        a1 = a;
        b1 = b;
        n1 = n;

        d = min(b1 - y, n1);
        b1 -= d;
        n1 -= d;
        d = min(a1 - x, n1);
        a1 -= d;

        long long ans2 = a1 * b1;

        cout << min(ans1, ans2) << '\n';
    }

    return 0;
}
