Problem Link:
https://leetcode.com/problems/find-target-indices-after-sorting-array/description/?envType=daily-question&envId=2026-10-19

Solution:
class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        int smaller = 0, equal = 0;

        for(int x : nums) 
        {
            if(x < target) 
                smaller++;
            else if(x == target) 
                equal++;
        }

        vector<int> v;
        for(int i = smaller; i < smaller + equal; i++) 
        {
            v.push_back(i);
        }

        return v;
    }
};
