#include <bits/stdc++.h>
using namespace std;

struct Fenwick {
    int n;
    vector<int> bit;
    Fenwick(int n) : n(n), bit(n + 1, 0) {}
    void add(int idx, int val) 
    {
        while(idx <= n) 
        {
            bit[idx] += val;
            idx += idx & -idx;
        }
    }
    int sum(int idx) 
    {
        int r = 0;
        while(idx > 0) 
        {
            r += bit[idx];
            idx -= idx & -idx;
        }
        return r;
    }
};

int main() {
    int t;
    cin >> t;
    while(t--) {
        int n;
        cin >> n;
        vector<long long> a(n + 1);
        for(int i = 1; i <= n; i++) 
            cin >> a[i];

        Fenwick ft(n);
        long long ans = 0;

        for(int j = 1; j <= n; j++) 
        {
            if(a[j] < j) 
            {
                int x = (int)a[j] - 1;
                if(x > 0) 
                    ans += ft.sum(min(x, n));
            }
            if(a[j] < j) 
                ft.add(j, 1);
        }

        cout << ans << "\n";
    }
    return 0;
}
