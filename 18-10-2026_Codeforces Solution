#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cin >> n;

    vector<long long> a(n);
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    sort(a.begin(), a.end());

    long long sum = 0;
    int count = 0;

    for(int i = 0; i < n; i++)
    {
        if(sum <= a[i])
        {
            count++;
            sum += a[i];
        }
    }

    cout << count << "\n";
    return 0;
}
