#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        string s;
        cin >> n >> s;

        int c = 0, m = 0;

        for(char ch : s) 
        {
            if(ch == '#') 
            {
                c++;
                m = max(m, c);
            } 
            else 
            {
                c = 0;
            }
        }

        cout << (m + 1) / 2 << '\n';
    }

    return 0;
}
