#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n, k;
        cin >> n >> k;

        vector<long long> b(k + 1, 0);

        for(int i = 0; i < k; i++) 
        {
            int x;
            long long c;
            cin >> x >> c;
            b[x] += c;
        }

        sort(b.rbegin(), b.rend());

        long long m = 0;
        int s = min(n, k);

        for(int i = 0; i < s; i++) 
        {
            m += b[i];
        }

        cout << m << "\n";
    }

    return 0;
}
