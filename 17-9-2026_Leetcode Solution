Problem Link:
https://leetcode.com/problems/find-two-non-overlapping-sub-arrays-each-with-target-sum/?envType=daily-question&envId=2026-09-17

Solution:
class Solution {
public:
    int minSumOfLengths(vector<int>& arr, int t) {
        int n = arr.size();
        const int m = 1e9;
        vector<int> v(n, m);

        int l = 0;
        long long s = 0;
        int ms = m;

        for(int r = 0; r < n; r++)
        {
            s += arr[r];

            while(s > t)
            {
                s -= arr[l++];
            }

            if(s == t)
            {
                int len = r - l + 1;

                if(l > 0 && v[l - 1] != m)
                {
                    ms = min(ms, len + v[l - 1]);
                }

                v[r] = len;
            }

            if(r > 0)
            {
                v[r] = min(v[r], v[r - 1]);
            }
        }

        return ms == m ? -1 : ms;
    }
};
