Problem Link:
https://leetcode.com/problems/twisted-mirror-path-count/?envType=daily-question&envId=2026-10-31 

Solution:
class Solution {
    static const int mod = 1e9 + 7;

    public:
    int uniquePaths(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        vector<vector<long long>> dp(n, vector<long long>(2, 0));

        dp[0][0] = 1;

        for(int i = 0; i < m; i++)
        {
            for(int j = 0; j < n; j++)
            {
                long long down = 0;
                long long right = 0;

                if(i > 0)
                {
                    if(grid[i - 1][j] == 0)
                    {
                        down = (dp[j][0] + dp[j][1]) % mod;
                    }
                    else
                    {
                        down = dp[j][1];
                    }
                }

                if(j > 0)
                {
                    if(grid[i][j - 1] == 0)
                    {
                        right = (dp[j - 1][0] + dp[j - 1][1]) % mod;
                    }
                    else
                    {
                        right = dp[j - 1][0];
                    }
                }

                if(i == 0 && j == 0)
                {
                    continue;
                }

                dp[j][0] = down;
                dp[j][1] = right;
            }
        }

        return (dp[n - 1][0] + dp[n - 1][1]) % mod;
    }
};
