Solution:
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n, q;
    cin >> n >> q;

    vector<long long> p(n + 1);

    for(int i = 1; i <= n; i++)
        cin >> p[i];

    sort(p.begin() + 1, p.end(), greater<long long>());

    vector<long long> pref(n + 1);

    for(int i = 1; i <= n; i++)
        pref[i] = pref[i - 1] + p[i];

    while(q--)
    {
        int x, y;
        cin >> x >> y;

        cout << pref[x] - pref[x - y] << '\n';
    }

    return 0;
}
