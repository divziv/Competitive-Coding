Problem Link:
https://leetcode.com/problems/smallest-missing-multiple-of-k/?envType=daily-question&envId=2026-08-25

Solution:
class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        set<int> s(nums.begin(), nums.end());

        int multiple = k;

        while(s.count(multiple)) 
        {
            multiple += k;
        }

        return multiple;
    }
};
