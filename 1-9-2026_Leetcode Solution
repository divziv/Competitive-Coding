Problem Link:
https://leetcode.com/problems/minimum-moves-to-clean-the-classroom/?envType=daily-question&envId=2026-09-01

Solution:
class Solution {
public:
    int minMoves(vector<string>& classroom, int energy) {
        int m = classroom.size();
        int n = classroom[0].size();

        vector<vector<int>> v(m, vector<int>(n, -1));

        int cnt = 0;
        int sr = -1, sc = -1;

        for(int r = 0; r < m; r++)
        {
            for(int c = 0; c < n; c++)
            {
                if(classroom[r][c] == 'S')
                {
                    sr = r;
                    sc = c;
                }
                else if(classroom[r][c] == 'L')
                {
                    v[r][c] = cnt++;
                }
            }
        }

        if(cnt == 0)
            return 0;

        int fmask = (1 << cnt) - 1;

        struct State {
            int r, c, mask, e, dist;
        };

        queue<State> q;

        int masks = 1 << cnt;

        long long totalStates =
            1LL * m * n * masks * (energy + 1);

        vector<char> visited(totalStates, false);

        auto getId = [&](int r, int c, int mask, int e) -> long long
        {
            return (((1LL * r * n + c) * masks + mask)
                    * (energy + 1) + e);
        };

        visited[getId(sr, sc, 0, energy)] = true;
        q.push({sr, sc, 0, energy, 0});

        int dr[4] = {1, -1, 0, 0};
        int dc[4] = {0, 0, 1, -1};

        while(!q.empty())
        {
            State cur = q.front();
            q.pop();

            int r = cur.r;
            int c = cur.c;
            int mask = cur.mask;
            int e = cur.e;
            int dist = cur.dist;

            for(int d = 0; d < 4; d++)
            {
                int nr = r + dr[d];
                int nc = c + dc[d];

                if(nr < 0 || nr >= m || nc < 0 || nc >= n)
                    continue;

                if(classroom[nr][nc] == 'X')
                    continue;

                if(e == 0)
                    continue;

                int ne = e - 1;
                int nmask = mask;

                if(classroom[nr][nc] == 'L')
                {
                    nmask |= (1 << v[nr][nc]);
                }

                if(classroom[nr][nc] == 'R')
                {
                    ne = energy;
                }

                if(nmask == fmask)
                    return dist + 1;

                long long id = getId(nr, nc, nmask, ne);

                if(!visited[id])
                {
                    visited[id] = true;
                    q.push({nr, nc, nmask, ne, dist + 1});
                }
            }
        }

        return -1;
    }
};
