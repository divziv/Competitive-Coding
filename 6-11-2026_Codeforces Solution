#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<long long> a(n + 1, 0);

        for(int i = 1; i <= n; i++)
        {
            cin >> a[i];
            a[i] += a[i - 1];
        }

        string s;
        cin >> s;
        s = " " + s;

        long long total_score = 0;
        int left = 1, right = n;

        while(left < right)
        {
            while(left < right && s[left] != 'L')
            {
                left++;
            }

            while(left < right && s[right] != 'R')
            {
                right--;
            }

            if(left < right)
            {
                total_score += (a[right] - a[left - 1]);
                left++;
                right--;
            }
        }

        cout << total_score << "\n";
    }

    return 0;
}
