#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        vector<long long> a(n);
        for(auto &x : a) 
            cin >> x;

        int m = 0;

        for(int i = 0; i < n; ++i) 
        {
            set<long long> s;
            for(auto x : a) 
                s.insert(x - a[i]);

            int mex = 0;
            while(s.count(mex)) 
                ++mex;
            m = max(m, mex);
        }

        cout << m << '\n';
    }

    return 0;
}
