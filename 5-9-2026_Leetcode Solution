Problem Link:
https://leetcode.com/problems/smallest-stable-index-ii/?envType=daily-question&envId=2026-09-05

Solution:
class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        vector<long long> v(n);

        v[n - 1] = nums[n - 1];

        for(int i = n - 2; i >= 0; --i)
        {
            v[i] = min(v[i + 1], (long long)nums[i]);
        }

        long long m = nums[0];

        for(int i = 0; i < n; ++i)
        {
            m = max(m, (long long)nums[i]);

            if(m - v[i] <= k)
            {
                return i;
            }
        }

        return -1;
    }
};
