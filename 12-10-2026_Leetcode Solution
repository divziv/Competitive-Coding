Solution:
class Solution {
public:
    int maxSum(vector<int>& nums, int k) {
        const long long mod = 1e9 + 7;
        vector<int> bits(32, 0);

        for(int num : nums) 
        {
            for(int b = 0; b < 32; b++) 
            {
                if(num & (1 << b)) 
                {
                    bits[b]++;
                }
            }
        }

        long long m = 0;

        for(int i = 0; i < k; i++) 
        {
            long long num = 0;

            for(int b = 0; b < 32; b++) 
            {
                if(bits[b] > 0) 
                {
                    num |= (1LL << b);
                    bits[b]--;
                }
            }

            m = (m + num * num % mod) % mod;
        }

        return m;
    }
};
