Problem Link:
https://leetcode.com/problems/palindromic-path-queries-in-a-tree/?envType=daily-question&envId=2026-10-29

Solution:
class Solution {
    vector<vector<int>> adj, up;
    vector<int> tin, tout, depth, bit;
    string s;
    int timer = 0, LOG;

    void add(int i, int val) {
        for(; i < (int)bit.size(); i += i & -i)
        {
            bit[i] ^= val;
        }
    }

    int pref(int i) {
        int res = 0;

        for(; i > 0; i -= i & -i)
        {
            res ^= bit[i];
        }

        return res;
    }

    int getMask(int u) {
        return pref(tin[u]);
    }

    void dfs(int u, int p) {
        tin[u] = ++timer;
        up[u][0] = p;

        for(int j = 1; j < LOG; ++j)
        {
            up[u][j] = up[up[u][j - 1]][j - 1];
        }

        for(int v : adj[u])
        {
            if(v == p)
            {
                continue;
            }

            depth[v] = depth[u] + 1;
            dfs(v, u);
        }

        tout[u] = timer;
    }

    int lca(int u, int v) {
        if(depth[u] < depth[v])
        {
            swap(u, v);
        }

        int diff = depth[u] - depth[v];

        for(int j = 0; j < LOG; ++j)
        {
            if(diff & (1 << j))
            {
                u = up[u][j];
            }
        }

        if(u == v)
        {
            return u;
        }

        for(int j = LOG - 1; j >= 0; --j)
        {
            if(up[u][j] != up[v][j])
            {
                u = up[u][j];
                v = up[v][j];
            }
        }

        return up[u][0];
    }

public:
    vector<bool> palindromePath(int n, vector<vector<int>>& edges,
                                string s, vector<string>& queries) {
        this->s = s;
        adj.assign(n, {});

        for(auto &e : edges)
        {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        LOG = 1;

        while((1 << LOG) <= n)
        {
            ++LOG;
        }

        up.assign(n, vector<int>(LOG, 0));
        tin.resize(n);
        tout.resize(n);
        depth.assign(n, 0);
        bit.assign(n + 2, 0);
        timer = 0;

        dfs(0, 0);

        for(int u = 0; u < n; ++u)
        {
            int mask = 1 << (s[u] - 'a');
            add(tin[u], mask);
            add(tout[u] + 1, mask);
        }

        vector<bool> ans;

        for(string &q : queries)
        {
            stringstream ss(q);
            string type;
            int u;

            ss >> type >> u;

            if(type == "update")
            {
                char c;
                ss >> c;

                if(s[u] != c)
                {
                    int delta = (1 << (s[u] - 'a')) ^
                                (1 << (c - 'a'));

                    add(tin[u], delta);
                    add(tout[u] + 1, delta);
                    s[u] = c;
                }
            }
            else
            {
                int v;
                ss >> v;

                int w = lca(u, v);
                int mask = getMask(u) ^ getMask(v) ^
                           (1 << (s[w] - 'a'));

                ans.push_back((mask & (mask - 1)) == 0);
            }
        }

        return ans;
    }
};
