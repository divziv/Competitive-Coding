#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) 
    {
        string n;
        cin >> n;

        int last = -1;
        for(int i = 0; i < (int)n.size(); i++) 
        {
            if(n[i] != '0') 
                last = i;
        }

        int zeros = 0;
        for(int i = 0; i < last; i++) 
        {
            if(n[i] == '0') 
                zeros++;
        }

        cout << (int)n.size() - zeros - 1 << "\n";
    }

    return 0;
}
