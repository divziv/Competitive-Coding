https://leetcode.com/problems/smallest-palindromic-rearrangement-i/?envType=daily-question&envId=2026-07-28

Solution:
class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> cnt(26, 0);
        for(char c : s) 
            cnt[c - 'a']++;

        string half = "";
        char mid = 0;

        for(int i = 0; i < 26; i++) 
        {
            half.append(cnt[i] / 2, char('a' + i));
            if(cnt[i] % 2) 
                mid = char('a' + i);
        }

        string t = half;
        if(mid) 
            t.push_back(mid);

        reverse(half.begin(), half.end());
        t += half;

        return t;
    }
};
