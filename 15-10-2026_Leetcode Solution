Problem Link:
https://leetcode.com/problems/subarrays-distinct-element-sum-of-squares-i/?envType=daily-question&envId=2026-10-15

Solution:
class Solution {
public:
    int sumCounts(vector<int>& nums) {
        int n = nums.size();
        int c = 0;

        for(int i = 0; i < n; i++) 
        {
            set<int> s;

            for(int j = i; j < n; j++) 
            {
                s.insert(nums[j]);

                int d = s.size();
                c += d * d;
            }
        }

        return c;
    }
};
