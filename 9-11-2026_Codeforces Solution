#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    
    while(t--) {
        int n;
        cin >> n;
        
        vector<int> a(n);
        for(int i = 0; i < n; ++i) 
        {
            cin >> a[i];
        }
    
        int m = 0;
        int c = 0;
    
        for(int i = 0; i < n; ++i) 
        {
            if(i == 0) 
            {
                m = a[i];
            } 
            else 
            {
                if(a[i] < m) 
                {
                    c++;
                } 
                else 
                {
                    m = a[i];
                }
            }
        }
    
        cout << c << "\n";
    }
    return 0;
}
