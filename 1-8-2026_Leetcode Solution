https://leetcode.com/problems/predict-the-winner/?envType=daily-question&envId=2026-08-01

Solution:
class Solution {
public:
    vector<vector<int>> memo;

    int solve(vector<int>& nums, int l, int r) {
        if(l == r) 
            return nums[l];

        if(memo[l][r] != INT_MIN)
            return memo[l][r];

        int takeLeft = nums[l] - solve(nums, l + 1, r);
        int takeRight = nums[r] - solve(nums, l, r - 1);

        return memo[l][r] = max(takeLeft, takeRight);
    }

    bool predictTheWinner(vector<int>& nums) {
        int n = nums.size();
        memo.assign(n, vector<int>(n, INT_MIN));
        return solve(nums, 0, n - 1) >= 0;
    }
};
