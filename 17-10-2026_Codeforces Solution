#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        long long l, r;
        cin >> n >> l >> r;

        vector<long long> a(n + 1);
        bool ok = true;

        for(int i = 1; i <= n; i++)
        {
            a[i] = ((l + i - 1) / i) * i;

            if(a[i] > r)
            {
                ok = false;
                break;
            }
        }

        if(!ok)
        {
            cout << "NO\n";
            continue;
        }

        cout << "YES\n";

        for(int i = 1; i <= n; i++)
        {
            cout << a[i] << (i == n ? '\n' : ' ');
        }
    }

    return 0;
}
