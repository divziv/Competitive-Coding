Problem Link:
https://leetcode.com/problems/shortest-and-lexicographically-smallest-beautiful-string/?envType=daily-question&envId=2026-08-26

Solution:
class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int b = -1;
        int minLength = s.length() + 1;
        int ones = 0;

        for(int l = 0, r = 0; r < s.length(); ++r) 
        {
            if(s[r] == '1')
                ++ones;

            while(ones == k) 
            {
                if(r - l + 1 < minLength) 
                {
                    b = l;
                    minLength = r - l + 1;
                } 
                else if(r - l + 1 == minLength && s.compare(l, minLength, s, b, minLength) < 0) 
                {
                    b = l;
                }

                if(s[l++] == '1')
                    --ones;
            }
        }

        return b == -1 ? "" : s.substr(b, minLength);
    }
};
