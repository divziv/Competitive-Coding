#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<pair<int, int>> a(n);

        for(int i = 0; i < n; i++)
        {
            cin >> a[i].first;
            a[i].second = i + 1;
        }

        sort(a.rbegin(), a.rend());

        vector<int> x(n + 1);
        x[0] = 0;

        long long s = 0;
        int pos = 1;

        for(int i = 0; i < n; i++)
        {
            if(i % 2 == 0)
            {
                x[a[i].second] = pos;
            }
            else
            {
                x[a[i].second] = -pos;
                ++pos;
            }

            s += 2LL * a[i].first * (pos - 1 + (i % 2 == 0));
        }

        cout << s << '\n';

        for(int i = 0; i <= n; i++)
            cout << x[i] << ' ';

        cout << '\n';
    }

    return 0;
}
