https://leetcode.com/problems/distinct-subsequences-ii/?envType=daily-question&envId=2026-09-07

Solution:
class Solution {
public:
    int distinctSubseqII(string s) {
        const long long m = 1e9 + 7;

        long long dp = 1;
        vector<long long> v(26, 0);

        for(char c : s) 
        {
            int x = c - 'a';
            long long n = (2 * dp - v[x] + m) % m;
            v[x] = dp;
            dp = n;
        }

        return (dp - 1 + m) % m;
    }
};
