https://leetcode.com/problems/minimum-cost-to-acquire-required-items/?envType=daily-question&envId=2026-11-11

Solution:
class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long long option1 = need1 * 1LL * cost1 + need2 * 1LL * cost2;
        long long option2 = min(need1, need2) * 1LL * costBoth + (need1 - min(need1, need2)) * 1LL * cost1 + (need2 - min(need1, need2)) * 1LL * cost2;
        long long option3 = max(need1, need2) * 1LL * costBoth;

        return min({option1, option2, option3});
    }
};
