#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<int> c(n);
        for(int i = 0; i < n; ++i)
        {
            cin >> c[i];
        }

        sort(c.begin(), c.end());

        if(c[0] != 1)
        {
            cout << "NO\n";
            continue;
        }

        long long running_sum = c[0];
        bool possible = true;

        for(int i = 1; i < n; ++i)
        {
            if(c[i] > running_sum)
            {
                possible = false;
                break;
            }

            running_sum += c[i];
        }

        if(possible)
        {
            cout << "YES\n";
        }
        else
        {
            cout << "NO\n";
        }
    }

    return 0;
}
