#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    int m = 0;
    for(int i = 0; i < n; ++i) 
    {
        int h;
        cin >> h;
        m = max(m, h);
    }

    cout << m << "\n";

    return 0;
}
