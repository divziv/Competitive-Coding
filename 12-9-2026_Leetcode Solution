Problem Link:
https://leetcode.com/problems/maximum-score-of-non-overlapping-intervals/?envType=daily-question&envId=2026-09-12

Solution:
class Solution {
public:
    struct Node
    {
        long long score;
        vector<int> ids;
    };

    bool better(const Node& a, const Node& b) {
        if(a.score != b.score)
            return a.score > b.score;

        return a.ids < b.ids;
    }

    vector<int> maximumWeight(vector<vector<int>>& intervals) {
        int n = intervals.size();

        vector<array<long long, 4>> a;

        for(int i = 0; i < n; i++)
        {
            a.push_back({
                intervals[i][0],
                intervals[i][1],
                intervals[i][2],
                i
            });
        }

        sort(a.begin(), a.end());

        vector<int> nxt(n);

        for(int i = 0; i < n; i++)
        {
            int lo = i + 1, hi = n;

            while(lo < hi)
            {
                int mid = lo + (hi - lo) / 2;

                if(a[mid][0] > a[i][1])
                    hi = mid;
                else
                    lo = mid + 1;
            }

            nxt[i] = lo;
        }

        vector<vector<Node>> dp(n + 1, vector<Node>(5));

        for(int i = 0; i <= n; i++)
            dp[i][0] = {0, {}};

        for(int i = n - 1; i >= 0; i--)
        {
            for(int k = 1; k <= 4; k++)
            {
                Node best = dp[i + 1][k];

                Node take = dp[nxt[i]][k - 1];
                take.score += a[i][2];
                take.ids.push_back((int)a[i][3]);

                sort(take.ids.begin(), take.ids.end());

                if(better(take, best))
                    best = take;

                dp[i][k] = best;
            }
        }

        return dp[0][4].ids;
    }
};
