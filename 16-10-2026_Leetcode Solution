https://leetcode.com/problems/subarrays-distinct-element-sum-of-squares-ii/?envType=daily-question&envId=2026-10-16

Solution:
class Solution {
public:
    static const int m = 1e9 + 7;

    struct Node {
        long long sum, sums, lazy;
    };

    vector<Node> tree;
    int n;

    void build(int node, int l, int r) {
        tree[node] = {0, 0, 0};
        if(l == r) 
            return;

        int mid = (l + r) / 2;
        build(node * 2, l, mid);
        build(node * 2 + 1, mid + 1, r);
    }

    void apply(int node, int l, int r, long long v) {
        long long len = r - l + 1;
        long long oldSum = tree[node].sum;

        tree[node].sums = (tree[node].sums + 2 * v % m * oldSum % m + len % m * v % m * v % m) % m;
        tree[node].sum = (oldSum + len * v) % m;
        tree[node].lazy = (tree[node].lazy + v) % m;
    }

    void push(int node, int l, int r) {
        if(tree[node].lazy == 0 || l == r) 
            return;

        int mid = (l + r) / 2;
        apply(node * 2, l, mid, tree[node].lazy);
        apply(node * 2 + 1, mid + 1, r, tree[node].lazy);
        tree[node].lazy = 0;
    }

    void update(int node, int l, int r, int ql, int qr) {
        if(ql > r || qr < l) 
            return;

        if(ql <= l && r <= qr)
        {
            apply(node, l, r, 1);
            return;
        }

        push(node, l, r);
        int mid = (l + r) / 2;

        update(node * 2, l, mid, ql, qr);
        update(node * 2 + 1, mid + 1, r, ql, qr);

        tree[node].sum = (tree[node * 2].sum + tree[node * 2 + 1].sum) % m;
        tree[node].sums = (tree[node * 2].sums + tree[node * 2 + 1].sums) % m;
    }

    int sumCounts(vector<int>& nums) {
        n = nums.size();
        tree.resize(4 * n);
        build(1, 0, n - 1);

        vector<int> last(100001, -1);
        long long s = 0;

        for(int i = 0; i < n; i++)
        {
            int prev = last[nums[i]];

            update(1, 0, n - 1, prev + 1, i);
            last[nums[i]] = i;

            s = (s + tree[1].sums) % m;
        }

        return s;
    }
};
