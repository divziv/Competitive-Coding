#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n, m;
        cin >> n >> m;
        vector<vector<int>> a(n, vector<int>(m));
        for(int i = 0; i < n; i++)
            for(int j = 0; j < m; j++)
                cin >> a[i][j];

        long long s = 0;
        vector<int> col(n);

        for(int j = 0; j < m; j++) 
        {
            for(int i = 0; i < n; i++) 
                col[i] = a[i][j];
            sort(col.begin(), col.end());
            long long pref = 0;
            for(int i = 0; i < n; i++) 
            {
                s += 1LL * col[i] * i - pref;
                pref += col[i];
            }
        }

        cout << s << "\n";
    }

    return 0;
}
