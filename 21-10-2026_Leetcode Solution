Problem Link:
https://leetcode.com/problems/minimum-operations-to-sort-a-string/?envType=daily-question&envId=2026-10-21

Solution:
class Solution {
public:
    int minOperations(std::string s) {
        int n = s.size();

        bool f = true;
        for(int i = 1; i < n; ++i)
        {
            if(s[i] < s[i - 1])
            {
                f = false;
                break;
            }
        }

        if(f) 
            return 0;

        if(n == 2) 
            return -1;

        char mn = *std::min_element(s.begin(), s.end());
        char mx = *std::max_element(s.begin(), s.end());

        if(s[0] == mn || s[n - 1] == mx)
        {
            return 1;
        }

        for(int i = 1; i < n - 1; ++i)
        {
            if(s[i] == mn || s[i] == mx)
            {
                return 2;
            }
        }

        return 3;
    }
};
