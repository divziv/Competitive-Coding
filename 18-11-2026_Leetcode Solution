Problem Link:
https://leetcode.com/problems/minimum-number-of-changes-to-make-binary-string-beautiful/?envType=daily-question&envId=2026-11-18

Solution:
class Solution {
public:
    int minChanges(string s) {
        int c = 0;

        for(int i = 0; i < s.size(); i += 2) 
        {
            if(s[i] != s[i + 1]) 
            {
                c++;
            }
        }

        return c;
    }
};
