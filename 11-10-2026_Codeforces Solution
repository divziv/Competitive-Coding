#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<int> a(n);
        for(int i = 0; i < n; i++)
        {
            cin >> a[i];
        }

        vector<vector<int>> dp(n + 1, vector<int>(2, 1e9));

        dp[n][0] = 0;
        dp[n][1] = 0;

        for(int i = n - 1; i >= 0; i--)
        {
            int c1 = a[i] + dp[i + 1][0];
            int c2 = 1e9;

            if(i + 1 < n)
            {
                c2 = a[i] + a[i + 1] + dp[i + 2][0];
            }
            else
            {
                c2 = a[i] + dp[n][0];
            }

            dp[i][1] = min(c1, c2);

            int o1 = dp[i + 1][1];
            int o2 = dp[min(i + 2, n)][1];

            dp[i][0] = min(o1, o2);
        }

        cout << dp[0][1] << "\n";
    }

    return 0;
}
