#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        long long s = 0, p, c;
        cin >> p;

        for(int i = 1; i < n; ++i) 
        {
            cin >> c;
            s = max(s, p * c);
            p = c;
        }

        cout << s << '\n';
    }

    return 0;
}
