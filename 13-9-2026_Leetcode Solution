https://leetcode.com/problems/image-overlap/?envType=daily-question&envId=2026-09-13

Solution:
class Solution {
public:
    int largestOverlap(vector<vector<int>>& img1, vector<vector<int>>& img2) {
        int n = img1.size();
        int m = 0;

        for(int r = -(n - 1); r <= n - 1; r++)
        {
            for(int c = -(n - 1); c <= n - 1; c++)
            {
                int overlap = 0;

                for(int i = 0; i < n; i++)
                {
                    for(int j = 0; j < n; j++)
                    {
                        int ni = i + r;
                        int nj = j + c;

                        if(ni >= 0 && ni < n && nj >= 0 && nj < n)
                        {
                            if(img1[i][j] == 1 && img2[ni][nj] == 1)
                            {
                                overlap++;
                            }
                        }
                    }
                }

                m = max(m, overlap);
            }
        }

        return m;
    }
};
