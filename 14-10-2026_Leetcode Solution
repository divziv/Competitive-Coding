Problem Link:
https://leetcode.com/problems/maximize-sum-of-squares-of-digits/?envType=daily-question&envId=2026-10-14

Solution:
class Solution {
public:
    string maxSumOfSquares(int num, int sum) {
        if(sum > 9 * num) 
        {
            return "";
        }

        string m = "";

        for(int i = 0; i < num; i++) 
        {
            int digit = min(9, sum);
            m += to_string(digit);
            sum -= digit;
        }

        return m;
    }
};
