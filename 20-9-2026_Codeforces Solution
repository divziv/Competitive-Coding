#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        map<int, int> c;

        for(int j = 0; j < n; ++j) 
        {
            int x;
            cin >> x;

            for(int i = 2; i * i <= x; ++i) 
            {
                while(x % i == 0) 
                {
                    c[i]++;
                    x /= i;
                }
            }

            if(x > 1) 
                c[x]++;
        }

        bool f = true;

        for(auto [i, x] : c) 
        {
            if(x % n != 0) 
            {
                f = false;
                break;
            }
        }

        cout << (f ? "YES\n" : "NO\n");
    }

    return 0;
}
