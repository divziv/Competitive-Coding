Problem Link:
https://leetcode.com/problems/maximum-nesting-depth-of-two-valid-parentheses-strings/description/?envType=daily-question&envId=2026-09-30

Solution:
class Solution {
public:
    vector<int> maxDepthAfterSplit(string seq) {
        vector<int> v;
        int depth = 0;

        for(char c : seq)
        {
            if(c == '(')
            {
                depth++;
                v.push_back(depth % 2);
            }
            else
            {
                v.push_back(depth % 2);
                depth--;
            }
        }

        return v;
    }
};
