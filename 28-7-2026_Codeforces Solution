#include <bits/stdc++.h>
using namespace std;

int main() {
    int r, c;
    cin >> r >> c;
    vector<string> cake(r);
    for(int i = 0; i < r; i++) 
        cin >> cake[i];

    vector<bool> safeRow(r, true), safeCol(c, true);

    for(int i = 0; i < r; i++)
        for(int j = 0; j < c; j++)
            if(cake[i][j] == 'S') 
            {
                safeRow[i] = false;
                safeCol[j] = false;
            }

    int s = 0;
    for(int i = 0; i < r; i++)
        for(int j = 0; j < c; j++)
            if(safeRow[i] || safeCol[j])
                s++;

    cout << s << "\n";
    return 0;
}
