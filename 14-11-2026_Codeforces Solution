#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        long long k;
        cin >> n >> k;

        vector<pair<long long, int>> a(n);

        for(int i = 0; i < n; i++)
        {
            cin >> a[i].first;
            a[i].second = i;
        }

        vector<long long> b(n);

        for(int i = 0; i < n; i++)
        {
            cin >> b[i];
        }

        sort(a.begin(), a.end());
        sort(b.begin(), b.end());

        vector<long long> v(n);

        for(int i = 0; i < n; i++)
        {
            v[a[i].second] = b[i];
        }

        for(int i = 0; i < n; i++)
        {
            cout << v[i] << (i == n - 1 ? "" : " ");
        }

        cout << "\n";
    }

    return 0;
}
