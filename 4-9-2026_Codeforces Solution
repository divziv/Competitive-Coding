#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<int> a(n), b(n);

        for(int i = 0; i < n; i++)
            cin >> a[i];

        for(int i = 0; i < n; i++)
            cin >> b[i];

        for(int i = 0; i < n; i++)
        {
            if(a[i] > b[i])
                swap(a[i], b[i]);
        }

        int ma = 0, mb = 0;

        for(int i = 0; i < n; i++)
        {
            ma = max(ma, a[i]);
            mb = max(mb, b[i]);
        }

        cout << ma * mb << "\n";
    }

    return 0;
}
