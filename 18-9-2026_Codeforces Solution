#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    for(int &x : a) 
        cin >> x;

    int mn = *min_element(a.begin(), a.end());
    int mx = *max_element(a.begin(), a.end());

    int s = 0;
    for(int x : a) 
    {
        if(x > mn && x < mx)
            s++;
    }

    cout << s << '\n';

    return 0;
}
