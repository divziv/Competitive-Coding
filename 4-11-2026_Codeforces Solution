#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for(int i = 0; i < n; i++) 
        {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int m = 0;

        for(int i = 0; i < n; i++) 
        {
            for(int j = i; j < n; j++) 
            {
                if((a[i] + a[j]) % 2 == 0) 
                {
                    m = max(m, j - i + 1);
                }
            }
        }

        cout << n - m << "\n";
    }

    return 0;
}
