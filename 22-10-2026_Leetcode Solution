Problem Link:
https://leetcode.com/problems/minimum-operations-to-sort-a-permutation/?envType=daily-question&envId=2026-10-22

Solution:
class Solution {
public:
    int minOperations(vector<int>& nums) {
        int n = nums.size();
        int zero = -1;
        for(int i = 0; i < n; ++i)
        {
            if(nums[i] == 0)
            {
                zero = i;
                break;
            }
        }

        auto f = [&](int step) -> bool {
            for(int i = 1; i < n; ++i)
            {
                int prev = (zero + (i - 1) * step) % n;
                int curr = (zero + i * step) % n;
                if(prev < 0) prev += n;
                if(curr < 0) curr += n;
                if(nums[prev] > nums[curr])
                {
                    return false;
                }
            }
            return true;
        };

        int m = INT_MAX;

        if(f(1))
        {
            m = min(m, zero);
            m = min(m, n - zero + 2);
        }

        if(f(-1))
        {
            m = min(m, zero + 2);
            m = min(m, n - zero);
        }

        return m == INT_MAX ? -1 : m;
    }
};
