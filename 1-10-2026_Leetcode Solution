https://leetcode.com/problems/valid-parentheses/description/?envType=daily-question&envId=2026-10-01

Solution:
class Solution {
public:
    bool isValid(string s) {
        stack<char> st;

        for(char c : s) 
        {
            if(c == '(' || c == '[' || c == '{') 
            {
                st.push(c);
            } 
            else 
            {
                if(st.empty()) 
                    return false;

                char top = st.top();

                if((c == ')' && top != '(') || (c == ']' && top != '[') || (c == '}' && top != '{')) 
                {
                    return false;
                }

                st.pop();
            }
        }

        return st.empty();
    }
};
