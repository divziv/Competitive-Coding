Problem Link:
https://leetcode.com/problems/smallest-divisible-digit-product-i/?envType=daily-question&envId=2026-08-06

Solution:
class Solution {
public:
    int smallestNumber(int n, int t) {
        while(true) 
        {
            int x = n;
            int p = 1;
            
            if(x == 0) 
                p = 0;
            while(x > 0) 
            {
                p *= (x % 10);
                x /= 10;
            }
            
            if(p % t == 0)
                return n;
            
            n++;
        }
    }
};
