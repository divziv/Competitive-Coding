#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        string s;
        cin >> s;

        vector<char> v;
        vector<int> lower, upper;

        for(char c : s)
        {
            if(c == 'b')
            {
                if(!lower.empty())
                {
                    int pos = lower.back();
                    lower.pop_back();
                    v[pos] = 0;
                }
            }
            else if(c == 'B')
            {
                if(!upper.empty())
                {
                    int pos = upper.back();
                    upper.pop_back();
                    v[pos] = 0;
                }
            }
            else
            {
                int pos = v.size();
                v.push_back(c);

                if(islower(c))
                    lower.push_back(pos);
                else
                    upper.push_back(pos);
            }
        }

        for(char c : v)
        {
            if(c)
                cout << c;
        }

        cout << '\n';
    }

    return 0;
}
