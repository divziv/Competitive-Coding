Problem Link:
https://leetcode.com/problems/find-missing-elements/?envType=daily-question&envId=2026-08-04

Solution:
class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        vector<int> v;
        sort(nums.begin(), nums.end());

        set<int> s;

        for(int x : nums)
        {
            s.insert(x);
        }

        for(int i = nums[0]; i <= nums[nums.size()-1]; i++)
        {
            if(s.find(i) != s.end())
                continue;
            else
                v.push_back(i);
        }

        return v;
    }
};
