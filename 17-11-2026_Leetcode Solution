Problem Link:
https://leetcode.com/problems/minimum-changes-to-make-k-semi-palindromes/?envType=daily-question&envId=2026-11-17

Solution:
class Solution {
public:
    int minimumChanges(string s, int k)
    {
        int n = s.size();
        const int inf = 1e9;

        vector<vector<int>> cost(n, vector<int>(n, inf));

        for(int i = 0; i < n; i++)
        {
            for(int j = i + 1; j < n; j++)
            {
                int len = j - i + 1;

                for(int d = 1; d < len; d++)
                {
                    if(len % d != 0) 
                        continue;

                    int c = 0;

                    for(int x = 0; x < d; x++)
                    {
                        int l = i + x;
                        int r = i + x + ((len - 1 - x) / d) * d;

                        while(l < r)
                        {
                            if(s[l] != s[r])
                            {
                                c++;
                            }

                            l += d;
                            r -= d;
                        }
                    }

                    cost[i][j] = min(cost[i][j], c);
                }
            }
        }

        vector<vector<int>> dp(n + 1, vector<int>(k + 1, inf));

        dp[0][0] = 0;

        for(int p = 1; p <= k; p++)
        {
            for(int i = 2 * p; i <= n; i++)
            {
                for(int j = 2 * (p - 1); j <= i - 2; j++)
                {
                    if(dp[j][p - 1] == inf) 
                        continue;

                    dp[i][p] = min(
                        dp[i][p],
                        dp[j][p - 1] + cost[j][i - 1]
                    );
                }
            }
        }

        return dp[n][k];
    }
};
