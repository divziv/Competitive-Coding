Solution:
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    
    while(t--) {
        int n, x, m;
        cin >> n >> x >> m;
        
        int lb = x, rb = x;

        while(m--) 
        {
            int l, r;
            cin >> l >> r;
            
            if(max(l, lb) <= min(r, rb)) 
            {
                lb = min(lb, l);
                rb = max(rb, r);
            }
        }
        
        cout << (rb - lb + 1) << "\n";
    }
    
    return 0;
}
