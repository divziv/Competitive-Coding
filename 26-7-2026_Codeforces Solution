#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n, x;
        cin >> n >> x;
        vector<int> a(n);
        long long sum = 0;

        for(int i = 0; i < n; i++)
        {
            cin >> a[i];
            sum += a[i];
        }

        if(sum % x != 0)
        {
            cout << n << "\n";
            continue;
        }

        int first = -1, last = -1;

        for(int i = 0; i < n; i++)
        {
            if(a[i] % x != 0)
            {
                if(first == -1)
                {
                    first = i;
                }
                last = i;
            }
        }

        if(first == -1)
        {
            cout << -1 << "\n";
        }
        else
        {
            cout << max(n - first - 1, last) << "\n";
        }
    }

    return 0;
}
