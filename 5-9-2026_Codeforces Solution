Solution:
#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<vector<int>> g(n, vector<int>(n));

        for(int i = 0; i < n; ++i)
        {
            for(int j = 0; j < n; ++j)
            {
                cin >> g[i][j];
            }
        }

        vector<int> p(2 * n + 1, 0);
        vector<bool> v(2 * n + 1, false);

        for(int j = 0; j < n; ++j)
        {
            int idx = 1 + (j + 1);
            p[idx] = g[0][j];
            v[g[0][j]] = true;
        }

        for(int i = 1; i < n; ++i)
        {
            int idx = (i + 1) + n;
            p[idx] = g[i][n - 1];
            v[g[i][n - 1]] = true;
        }

        for(int val = 1; val <= 2 * n; ++val)
        {
            if(!v[val])
            {
                p[1] = val;
                break;
            }
        }

        for(int i = 1; i <= 2 * n; ++i)
        {
            cout << p[i] << (i == 2 * n ? "" : " ");
        }
        cout << "\n";
    }

    return 0;
}
