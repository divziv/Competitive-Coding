#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        for(int i = 0; i < n; i++) 
        {
            if(i % 2 == 0)
                cout << -1 << " ";
            else
                cout << (i == n - 1 ? 2 : 3) << " ";
        }
        cout << "\n";
    }

    return 0;
}
