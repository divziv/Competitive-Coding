Problem Link:
https://leetcode.com/problems/maximize-consecutive-elements-in-an-array-after-modification/?envType=daily-question&envId=2026-11-20

Solution:
class Solution {
public:
    int maxSelectedElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());

        map<int, int> dp;
        int m = 0;

        for(int x : nums) 
        {
            dp[x + 1] = dp[x] + 1;
            dp[x] = dp[x - 1] + 1;
            m = max({m, dp[x], dp[x + 1]});
        }

        return m;
    }
};
