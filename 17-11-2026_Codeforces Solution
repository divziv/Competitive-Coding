#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n, m;
        cin >> n >> m;

        vector<vector<int>> a(n, vector<int>(m));
        vector<long long> d1(n + m, 0), d2(n + m, 0);

        for(int i = 0; i < n; i++) 
        {
            for(int j = 0; j < m; j++) 
            {
                cin >> a[i][j];
                d1[i - j + m] += a[i][j];
                d2[i + j] += a[i][j];
            }
        }

        long long s = 0;
        for(int i = 0; i < n; i++) 
        {
            for(int j = 0; j < m; j++) 
            {
                long long c = d1[i - j + m] + d2[i + j] - a[i][j];
                s = max(s, c);
            }
        }

        cout << s << '\n';
    }

    return 0;
}
