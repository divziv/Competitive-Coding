#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    
    while(t--) {
        int n;
        cin >> n;
        int a[n];
        int c = 0;
        
        for(int i = 0; i < n; i++) 
        {
            cin >> a[i];
            if(a[i] == 1) 
            {
                c++;
            }
        }
        
        int s = (n - c) + (c + 1) / 2;
        cout << s << "\n";
    }
    return 0;
}
