Problem Link:
https://leetcode.com/problems/check-if-there-is-a-valid-parentheses-string-path/?envType=daily-question&envId=2026-09-29

Solution:
class Solution {
public:
    bool hasValidPath(vector<vector<char>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        if((m + n - 1) % 2 != 0)
            return false;

        vector<vector<unordered_set<int>>> dp(m, vector<unordered_set<int>>(n));

        if(grid[0][0] == ')')
            return false;

        dp[0][0].insert(1);

        for(int i = 0; i < m; i++)
        {
            for(int j = 0; j < n; j++)
            {
                if(i == 0 && j == 0)
                    continue;

                unordered_set<int> balances;

                if(i > 0)
                {
                    for(int x : dp[i - 1][j])
                        balances.insert(x);
                }

                if(j > 0)
                {
                    for(int x : dp[i][j - 1])
                        balances.insert(x);
                }

                for(int balance : balances)
                {
                    int newBalance = grid[i][j] == '('
                        ? balance + 1
                        : balance - 1;

                    if(newBalance >= 0)
                        dp[i][j].insert(newBalance);
                }
            }
        }

        return dp[m - 1][n - 1].count(0) > 0;
    }
};
