#include <bits/stdc++.h>
using namespace std;

const long long m = 1000000007;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        vector<long long> a(n), b(n);

        for(auto &x : a)
            cin >> x;

        for(auto &x : b)
            cin >> x;

        sort(a.begin(), a.end());
        sort(b.begin(), b.end());

        long long s = 1;

        for(int i = n - 1; i >= 0; --i) 
        {
            int c = a.end() - upper_bound(a.begin(), a.end(), b[i]);
            c -= n - 1 - i;

            if(c <= 0) 
            {
                s = 0;
                break;
            }

            s = s * c % m;
        }

        cout << s << '\n';
    }

    return 0;
}
