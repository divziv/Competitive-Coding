Solution:
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        vector<long long> v(n + 1);
        for(int i = 1; i <= n; ++i)
            cin >> v[i];

        vector<int> dp(n + 1, 1);
        int s = 1;

        for(int i = 1; i <= n; ++i) 
        {
            for(int j = i * 2; j <= n; j += i) 
            {
                if(v[i] < v[j])
                    dp[j] = max(dp[j], dp[i] + 1);
            }
            s = max(s, dp[i]);
        }

        cout << s << '\n';
    }

    return 0;
}
