Solution:
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n, q;
        cin >> n >> q;

        vector<long long> a(n);
        for(auto &v : a) 
            cin >> v;

        int mn = 31;

        while(q--) 
        {
            int x;
            cin >> x;

            if(x >= mn) 
                continue;

            long long p = 1LL << x;
            long long add = 1LL << (x - 1);

            for(auto &v : a) 
            {
                if(v % p == 0)
                    v += add;
            }

            mn = x;
        }

        for(auto v : a)
            cout << v << ' ';
        cout << '\n';
    }

    return 0;
}
