#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        string s;
        cin >> s;

        int c = 1;
        bool f = false;

        for(int i = 0; i + 1 < s.size(); i++) 
        {
            if(s[i] != s[i + 1])
                c++;

            if(s[i] == '0' && s[i + 1] == '1')
                f = true;
        }

        if(f)
            c--;

        cout << c << '\n';
    }

    return 0;
}
