#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--) {
        int n;
        cin >> n;
        
        vector<string> grid(n);
        for(int i = 0; i < n; i++) 
        {
            cin >> grid[i];
        }
        
        int f = 0;
        
        for(int i = 0; i < (n + 1) / 2; i++) 
        {
            for(int j = 0; j < n / 2; j++) 
            {
                int val1 = grid[i][j] - '0';
                int val2 = grid[j][n - 1 - i] - '0';
                int val3 = grid[n - 1 - i][n - 1 - j] - '0';
                int val4 = grid[n - 1 - j][i] - '0';
                
                int s = val1 + val2 + val3 + val4;
                f += min(s, 4 - s);
            }
        }
        
        cout << f << "\n";
    }
    
    return 0;
}
